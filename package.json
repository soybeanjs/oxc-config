{
  "name": "@soybeanjs/oxc-config",
  "version": "0.2.3",
  "description": "SoybeanJS's oxlint and oxfmt config",
  "keywords": [
    "eslint",
    "oxfmt",
    "oxlint",
    "prettier",
    "soybeanjs"
  ],
  "homepage": "https://github.com/soybeanjs/oxc-config",
  "bugs": {
    "url": "https://github.com/soybeanjs/oxc-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/oxc-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js",
      "require": "./dist/plugins/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "commit": "soy git-commit",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@soybeanjs/cli": "^1.8.2",
    "@soybeanjs/oxc-config": "link:dist",
    "@types/node": "^26.4.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm soy git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxlint . --fix && oxfmt"
  },
  "packageManager": "pnpm@11.25.0"
}
